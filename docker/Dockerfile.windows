# MinGW cross toolchain for a static Windows build of the C++ client.
# The Linux Qt 6.12 kit is mounted at /qt-host and used only for moc/rcc/uic.
FROM docker.io/library/fedora:44

RUN dnf install -y --setopt=install_weak_deps=False \
        cmake \
        ninja-build \
        gcc-c++ \
        perl \
        python3 \
        curl \
        ca-certificates \
        xz \
        tar \
        git \
        make \
        pkgconf-pkg-config \
        which \
        binutils \
        upx \
        mingw64-binutils \
        mingw64-gcc \
        mingw64-gcc-c++ \
        mingw64-winpthreads \
        mingw64-zlib \
    && dnf clean all

WORKDIR /src
